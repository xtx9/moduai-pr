{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "instructions": [
    "AGENTS.md",
    "docs/rule/*.md"
  ],
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/keys.json": "deny",
      "**/auth.json": "deny",
      "**/secrets/**": "deny",
      "**/.codex/keys/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "**": "allow",
      "**/.git/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/keys.json": "deny",
      "**/auth.json": "deny",
      "**/secrets/**": "deny",
      "**/node_modules/**": "deny",
      "**/.opencode/logs/**": "deny",
      "**/.opencode/data/**": "deny",
      "**/.opencode/cache/**": "deny",
      "**/.opencode/state/**": "deny",
      "**/.opencode/update-check.json": "deny"
    },
    "bash": {
      "*": "ask",
      "[Console]::*": "allow",
      "ConvertFrom-*": "allow",
      "ConvertFrom-* *": "allow",
      "Write-Output": "allow",
      "Write-Output *": "allow",
      "Join-Path": "allow",
      "Join-Path *": "allow",
      "Invoke-WebRequest": "allow",
      "Invoke-WebRequest *": "allow",
      "Get-Item": "allow",
      "Get-Item *": "allow",
      "git *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "tsc *": "allow",
      "pnpm *": "allow",
      "powershell *": "allow",
      "pwsh *": "allow",
      "cd *": "allow",
      "dir *": "allow",
      "ls *": "allow",
      "Get-*": "allow",
      "Get-* *": "allow",
      "Select-*": "allow",
      "Select-* *": "allow",
      "Where-*": "allow",
      "Where-* *": "allow",
      "Sort-*": "allow",
      "Sort-* *": "allow",
      "Group-*": "allow",
      "Group-* *": "allow",
      "Measure-*": "allow",
      "Measure-* *": "allow",
      "Out-*": "allow",
      "Out-* *": "allow",
      "Format-*": "allow",
      "Format-* *": "allow",
      "*; *": "ask",
      "Set-*": "ask",
      "New-*": "ask",
      "Start-*": "ask",
      "Stop-*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "Remove-*": "deny",
      "ri *": "deny",
      "rd *": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "format *": "deny",
      "Format-Volume *": "deny",
      "diskpart *": "deny",
      "Clear-*": "deny",
      "Invoke-Expression *": "deny",
      "iex *": "deny",
      "git push * --force*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "*/AppData/Local/Temp/opencode/*": "allow",
      "*/AppData/Local/npm-cache/_logs/*": "allow",
      "./.opencode/data/opencode/tool-output/*": "allow",
      "*/.claude/skills/*": "allow",
      "*/.agents/skills/*": "allow",
      "E:/up/0-project/git/xtx9999/doc/AI/**": "allow"
    }
  },
  "autoupdate": false
}
